{
  "manifest_version": 3,
  "name": "Mandarin time",
  "version": "1.0.0",
  "description": "Measures time on Mandarin YouTube, Readwise Reader and LLM chats, and sends it to the Mandarin time hub on this Mac.",
  "minimum_chrome_version": "130",
  "permissions": ["storage", "unlimitedStorage", "alarms", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.youtube.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://read.readwise.io/*"
  ],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Mandarin time" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["dist/youtube-main.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://www.youtube.com/*"], "js": ["dist/youtube.js"], "run_at": "document_idle" },
    {
      "matches": [
        "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://chat.deepseek.com/*",
        "https://www.doubao.com/*", "https://www.kimi.com/*", "https://kimi.com/*", "https://grok.com/*",
        "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://read.readwise.io/*"
      ],
      "js": ["dist/reading.js"],
      "run_at": "document_idle"
    }
  ]
}
